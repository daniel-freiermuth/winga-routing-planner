{
  "name": "@winga-weather-routing/windy-lib",
  "version": "0.1.0",
  "description": "Reverse-engineered Windy.com internal API client — tiles, point forecasts, auth",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/cjs/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json",
    "check": "tsc -p tsconfig.json",
    "test": "tsx --test './__tests__/**/*.test.ts'"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": ["windy", "weather", "forecast", "tiles", "signalk"],
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.0"
  },
  "peerDependencies": {
    "sharp": ">=0.33"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true,
      "description": "Required only for Node.js tile pixel sampling (sampleAtPosition). Not needed for browsers or for point forecasts."
    }
  }
}
